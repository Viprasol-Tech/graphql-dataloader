# Part of GraphQL DataLoader by Viprasol Tech Private Limited (https://viprasol.com).
# Copy to .env and adjust. The example/tests run fully offline; these knobs
# only influence optional behaviour.

# Maximum keys dispatched per batch (0 = unlimited).
DATALOADER_MAX_BATCH_SIZE=0

# Enable per-key caching (true/false).
DATALOADER_CACHE_ENABLED=true
